# Server-only secrets. These are read by the Cloudflare Pages Functions layer
# (context.env) and are NEVER bundled into the browser JS.
# Set them in: Cloudflare dashboard -> Pages -> Settings -> Environment variables,
# or locally in .dev.vars (gitignored) for `wrangler pages dev`.
#
# WARNING: do NOT re-add a VITE_ prefix to any of these — VITE_* values are
# inlined into the public bundle and leak the credential.

NDB_URL=https://ndb.3xbun.com
NDB_BASE_ID=your_nocodb_base_id
NDB_API=your_nocodb_api_token

# openssl rand -hex 32
AUTH_SESSION_SECRET=

DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-domain/api/auth/callback
